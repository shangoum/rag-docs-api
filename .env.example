# Copy to .env and adjust.

# Local default: SQLite file. docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./rag.db

# "fake" needs no API key (keyword embeddings + extractive answers).
# "openai" uses a real model for embeddings and answers.
LLM_PROVIDER=fake

# Any OpenAI-compatible API works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Free local alternative with Ollama (ollama pull llama3.1 && ollama pull nomic-embed-text):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# CHAT_MODEL=llama3.1
# EMBEDDING_MODEL=nomic-embed-text

# Chunks scoring below this similarity are ignored. Tune it for your embedding model.
MIN_SCORE=0.2
